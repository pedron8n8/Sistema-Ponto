# Deploy na VPS

# Backend
DATABASE_URL=postgresql://postgres:CHANGE_ME@YOUR_POSTGRES_HOST:5432/sistema_ponto?schema=public
POSTGRES_HOST=YOUR_POSTGRES_HOST
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sistema_ponto
POSTGRES_PORT=5432
REDIS_HOST=YOUR_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://omnipunt.com
CORS_ALLOWED_ORIGINS=https://omnipunt.com,https://www.omnipunt.com,https://app.omnipunt.com
JWT_SECRET=your_jwt_secret_here
TEAM_INVITE_HMAC_SECRET=defina_uma_chave_forte_para_convites_de_time
PUBLIC_API_HMAC_SECRET=defina_uma_chave_hmac_forte_com_32_chars_ou_mais

# --- MCP (conexao com modelos de IA) ---------------------------------------
# Identidade do Authorization Server e do resource server. Precisam ser as URLs
# publicas: e com elas que o Claude monta a descoberta OAuth
# (/.well-known/oauth-protected-resource e /.well-known/oauth-authorization-server).
MCP_ISSUER_URL=https://api.omnipunt.com
MCP_RESOURCE_URL=https://api.omnipunt.com/mcp
# Opcional: base da ponte interna (src/mcp/bridge.js), que reentra na propria API
# para herdar toda a cadeia de guards. Sem definir, deriva de PORT (3000 em dev,
# 3001 no container). So preencha se a API responder em outro host/porta.
# BACKEND_INTERNAL_URL=http://127.0.0.1:3001
# Timeout de uma tool MCP, em ms.
MCP_TOOL_TIMEOUT_MS=30000

# Frontend build-time values used by docker-compose.yml
VITE_API_URL=https://api.omnipunt.com/api/v1
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SEU_ANON_KEY
VITE_STRIPE_LINK_STARTER=
VITE_STRIPE_LINK_GROWTH=
VITE_STRIPE_LINK_PRO=
