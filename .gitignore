# Arquivos de ambiente (todos os niveis) - contem segredos
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# Stack local de teste e scripts que MEXEM em banco. Ficam fora do git de
# proposito: .env.docker-local carrega credenciais do compose local e os
# scripts abaixo escrevem no banco. O .env* generico acima nao pega
# `backend/.env.docker-local`, entao ele precisa estar aqui explicito — senao
# um `git add -A` distraido publicaria um arquivo de ambiente.
/docker-compose.local.yml
/docker-compose.teste.yml
backend/.env.docker-local
# Padroes, nao nomes: o primeiro script novo com nome fora da lista voltaria a
# ser commitavel, e sao justamente scripts que escrevem no banco.
backend/inspect-local-*.js
backend/seed-*.js
backend/verify-*-local.js
backend/recalc-*.js

# Scripts/dados locais que nao vao pra VPS
backend/scripts/start-ssh-tunnel.ps1
backend/scripts/pentest-phase2.js
backend/scripts/create-demo-seed.js
backend/demo-users.json

# Build nativo do Capacitor (os fontes de frontend/android e frontend/ios VAO pro git)
frontend/android/app/build
frontend/android/.gradle
frontend/ios/App/Pods
frontend/ios/App/build

# Assinatura de release do app nativo - keystore e senhas nunca vao pro git.
# frontend/android/.gitignore ja cobre a pasta do Android; estes padroes sao a rede de
# seguranca para um .jks que caia em qualquer outro lugar da arvore.
# O modelo versionado e frontend/android/keystore.properties.example.
*.jks
*.keystore
keystore.properties

